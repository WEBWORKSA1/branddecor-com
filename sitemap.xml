---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% if p.layout and p.url != "/404.html" %}<url><loc>{{ site.url }}{{ p.url | replace: "index.html", "" }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>{% if p.url == "/" %}1.0{% elsif p.article %}0.8{% else %}0.6{% endif %}</priority></url>
{% endif %}{% endfor %}</urlset>
